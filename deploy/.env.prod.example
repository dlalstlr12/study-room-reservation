# deploy/.env 로 복사해서 채운다.  (deploy/.env 는 .gitignore 에 등록됨 — 커밋 금지)
#   cp deploy/.env.prod.example deploy/.env

# --- DB (컨테이너 내부용 자격증명, 외부 노출 안 함) ---
MYSQL_DATABASE=study_room
MYSQL_USER=study_room
MYSQL_PASSWORD=change-me-db-pass
MYSQL_ROOT_PASSWORD=change-me-root-pass

# --- 앱 ---
# 32바이트 이상.  생성 예:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-string-min-32-bytes

# 프론트가 서비스되는 오리진.  EC2 는 배포 스크립트가 퍼블릭 IP 로 자동 세팅.
# 수동 지정 예:  http://13.125.0.1   또는  https://demo.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost
